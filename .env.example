# ==========================================
# .env.example
# ==========================================

# 1. Rename this file to .env
# 2. Fill in the required API keys and database credentials.

# --- Backend Configuration (Also copy to backend/.env if necessary) ---

# OpenAI API key for LLM operations
OPENAI_API_KEY="your_openai_api_key_here"

# Gemini API Key for image processing or text operations
GEMINI_API_KEY="your_gemini_api_key_here"

# News API key for live agriculture news
NEWS_API_KEY="your_news_api_key_here"

# MongoDB Database URI and DB name
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/agribot?retryWrites=true&w=majority"
MONGODB_DB_NAME="agribot"

# --- Frontend Configuration ---
# e.g. VITE_API_URL="http://127.0.0.1:8000"
